{
  "name": "React + Vite",
  "image": "node:26",
  "runArgs": [
    "--name",
    "landingpage_mtths"
    ],
  "workspaceFolder": "/workspaces/landpage_mtths",
  
  "forwardPorts": [5173],

  "portsAttributes": {
    "5173": {
      "label": "Vite",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "updateRemoteUserUID": true
}